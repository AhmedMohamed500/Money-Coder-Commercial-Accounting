    "@prisma/client": "6.12.0",
    "bcryptjs": "latest",
    "jose": "latest",
    "lucide-react": "latest",
    "next": "16.4.3",
    "nodemailer": "latest",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.3",
    "local-postgres": "^0.3.3",
    "playwright-core": "latest",
    "postcss": "latest",
    "prisma": "6.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
